# =============================================================================
# MCP REST Bridge —— 中间件编排环境变量（示例）
# =============================================================================
# 用法：cp .env.example .env  然后**改掉所有 `changeme`**
# ⚠️ `.env` 已被 .gitignore 忽略，**永不提交**；本文件只放占位值。
#
# 说明：这里只列 `docker-compose.middleware.yaml` 用得到的变量。
#       业务容器的 application 环境变量（MCP_* / SPRING_*）在另一份 `.env`
#       或 docker-compose.yaml 的 environment 段里，见《数据库设计》§12.1.1。
# =============================================================================

TZ=Asia/Shanghai

# -------------------------------- MySQL --------------------------------------
# 要求 8.0.30+（《数据库设计》§18 Q1）
#
# 🔴 同一件事两处命名，务必对齐（否则"库建对了、后端连不上"）：
#    本段这些是 **MySQL 容器自己用**的（镜像读取）
#    后端连它用的是 **`MCP_DB_*`**（见《数据库设计》§12.1.1 的 DB 组）
#    ⇒ `MYSQL_DATABASE` ≈ `MCP_DB_NAME`、`MYSQL_USER` ≈ `MCP_DB_USERNAME`、
#      `MYSQL_PASSWORD` ≈ `MCP_DB_PASSWORD`、`MYSQL_PORT` ≈ `MCP_DB_PORT`
#    刻意**不复用同一变量名**：容器口令与应用口令是两套生命周期，混用会锁死"只想改一边"的场景。
MYSQL_PORT=3306
MYSQL_DATABASE=mcp_bridge
MYSQL_USER=mcp
MYSQL_PASSWORD=changeme-mysql-user
MYSQL_ROOT_PASSWORD=changeme-mysql-root

# ---------------------------- 后端连接用（示例，留给业务 compose / 后端 env） -----------
# 这些**不被** docker-compose.middleware.yaml 使用，放这里是提醒"两处要一致"。
# MCP_DB_TYPE=mysql
# MCP_DB_HOST=mysql            # 业务 compose 内用服务名；宿主直连用 127.0.0.1
# MCP_DB_PORT=3306
# MCP_DB_NAME=mcp_bridge
# MCP_DB_USERNAME=mcp
# MCP_DB_PASSWORD=changeme-mysql-user

# ----------------------------- PostgreSQL -----------------------------------
# 双库路线的第二库，13 / 14（此处镜像取 14）
POSTGRES_PORT=5432
POSTGRES_DB=mcp_bridge
POSTGRES_USER=mcp
POSTGRES_PASSWORD=changeme-postgres

# -------------------------------- Redis -------------------------------------
# 会话存储 + `mcp_config` 失效广播；**必须设口令**（不设 = 内网裸奔）
REDIS_PORT=6379
REDIS_PASSWORD=changeme-redis

# -------------------------------- MinIO -------------------------------------
# 本期后端不连它（MCP_STORAGE_BACKEND=local）；这是二期 S3 后端的联调目标。
# ⚠️ `MCP_S3_ACCESS_KEY` / `MCP_S3_SECRET_KEY` 同时充当 MinIO 的 root 账号口令，
#    所以**二期接 S3 时这两个变量直接复用**，不用再配一套。
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MCP_S3_ACCESS_KEY=mcpbridge
MCP_S3_SECRET_KEY=changeme-minio-secret
MCP_S3_BUCKET=mcp-artifacts

# =============================================================================
# 二期预留（本期后端**不读**，先留着，接 S3 时填）
# -----------------------------------------------------------------------------
# MCP_STORAGE_BACKEND=s3
# MCP_S3_ENDPOINT=http://minio:9000
# MCP_S3_REGION=us-east-1
# MCP_S3_PATH_STYLE=true          # MinIO 等自建对象存储**必须 true**
# =============================================================================
