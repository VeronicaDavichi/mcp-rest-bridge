<?xml version="1.0" encoding="UTF-8"?>
<!--
  探针工程（spike probe），**不是** mcp-rest-bridge 的正式构建文件。
  目的：在 JDK 25 + Maven 3.9.16 上实测官方 MCP Java SDK 2.1.0 的若干疑点。
  位置故意放在 _work/spike/ 下，避免破坏仓库「设计阶段只有 Markdown + UI 资产」的边界。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>probe</groupId>
  <artifactId>mcp-probe</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>MCP SDK spike probe</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <mcp.sdk.version>2.1.0</mcp.sdk.version>
  </properties>

  <dependencies>
    <!-- 官方 SDK 的便利包 = mcp-core + mcp-json-jackson3（默认 Jackson 3，与 Spring Boot 4 对齐） -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <version>${mcp.sdk.version}</version>
    </dependency>
  </dependencies>
</project>
